# Local only. Copy to .dev.vars (gitignored) before `npx wrangler dev`.
# ADMIN_PASSWORD is required for the review desk. Use a long password.
# On the deployed Worker, set it with: npx wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=change-me-to-a-long-password

# Preview Turnstile secret (always passes). Production:
#   npx wrangler secret put TURNSTILE_SECRET
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
